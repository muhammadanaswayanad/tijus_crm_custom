<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View Extension -->
    <record id="crm_lead_view_form_inherit_tijus" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.tijus</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Add possible country field after phone field -->
            <xpath expr="//field[@name='phone']" position="after">
                <field name="possible_country"/>
            </xpath>
        </field>
    </record>

    <!-- Kanban View Extension for Leads -->
    <record id="crm_case_kanban_view_leads_inherit_tijus" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit.tijus</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <!-- Add flag to the kanban card - using a safer XPath -->
            <xpath expr="//div[hasclass('oe_kanban_content')]" position="inside">
                <t t-if="record.country_flag.value">
                    <div class="float-end" title="Detected Country">
                        <span t-esc="record.country_flag.value"/>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
    
    <!-- Opportunities Kanban View Extension -->
    <record id="crm_case_kanban_view_leads_opportunity_inherit_tijus" model="ir.ui.view">
        <field name="name">crm.lead.kanban.opportunity.inherit.tijus</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads_opportunity"/>
        <field name="arch" type="xml">
            <!-- Add flag to the opportunity kanban card - using a safer XPath -->
            <xpath expr="//div[hasclass('oe_kanban_content')]" position="inside">
                <t t-if="record.country_flag.value">
                    <div class="float-end" title="Detected Country">
                        <span t-esc="record.country_flag.value"/>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
